# ─── OpenAI API ───────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Serper Search API ───────────────────────────────────────────
SERPER_KEY=your_serper_api_key_here
SERPER_DAILY_CREDIT_LIMIT=150

# ─── PostgreSQL Database Connections ─────────────────────────────
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
DIRECT_URL=postgresql://user:password@host:port/database

# ─── Gmail SMTP Outreach Mailer ───────────────────────────────────
GMAIL_USER=your_email@domain.com
GMAIL_APP_PASSWORD=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ─── Outreach Quotas & Delay Controls ────────────────────────────
EMAIL_DAILY_LIMIT=200
EMAIL_SEND_DELAY_MIN_SEC=30
EMAIL_SEND_DELAY_MAX_SEC=60

# ─── Admin Dashboard Auth Security ──────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
SECRET_KEY=your_random_secret_key_string

# ─── Deployment Base URL ─────────────────────────────────────────
APP_BASE_URL=http://localhost:10000
PORT=10000
